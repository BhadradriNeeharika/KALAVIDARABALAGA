rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'neeharikabhadradri@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTroupe(data) {
      return data.keys().hasAll(['name', 'artForm', 'leadContact', 'contactPhone', 'district', 'ownerId'])
             && data.name is string && data.name.size() <= 100
             && data.artForm is string && data.artForm.size() <= 100
             && data.leadContact is string && data.leadContact.size() <= 100
             && data.contactPhone is string && data.contactPhone.size() <= 20
             && data.district is string && data.district.size() <= 50
             && data.ownerId == request.auth.uid;
    }

    match /troupes/{troupeId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(troupeId) && isValidTroupe(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) || isAdmin())
                    && isValidTroupe(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
